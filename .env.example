# ===== 服务端 =====
PORT=3000
HOST=0.0.0.0

# 数据目录、数据库路径与默认下载目录（相对项目根目录）
DATA_DIR=./data
# DB_PATH=./data/app.db
DOWNLOAD_DIR=./downloads

# yt-dlp / ffmpeg 可执行文件路径（可选，留空则自动探测 PATH 与 tools/ 目录）
YTDLP_PATH=./tools/yt-dlp.exe
FFMPEG_PATH=./tools/ffmpeg.exe
# Python 解释器与 yt-dlp 模块目录（可选，用于 python -m yt_dlp）
# PYTHON_PATH=python
# YTDLP_MODULE_DIR=./tools/ytdlp

# 最大并发下载任务数（1 / 2 / 3 / 5 / 10）
MAX_CONCURRENCY=3

# 科学上网 / HTTP(S) 代理（可选）：用于解析与下载被网络限制的站点
# 支持 http://、https://、socks5://；也可只写端口（默认 127.0.0.1）
# PROXY_URL=http://127.0.0.1:10020

# 额外允许跨源访问 API 的来源（逗号分隔）。
# 默认已允许同源、localhost / 127.0.0.1 与局域网 IP；仅在通过自定义域名访问时需要配置。
# CORS_ORIGINS=https://vdm.example.com
